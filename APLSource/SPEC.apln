:Namespace SPEC   ⍝ OpenAPI Specification Components

   :Namespace schemas
       video←(
        type: 'object'
        properties: (
            category: (type: 'string')
            description: (type: 'string')
            event: (type: 'string')
            event_shortname: (type: 'string')
            presented_at: (type: 'string' ⋄ format: 'date-time' ⋄ description: 'Presentation date as YYYY-MM-DD hh:mm:ss')
            presenter: (type: 'string' ⋄ description: 'Comma-separated list of presenter names')
            presenter_id: (type: 'array' ⋄ items: (type: 'integer') ⋄ description: 'List of presenter IDs')
            published_at: (type: 'string' ⋄ format: 'date-time' ⋄ description: 'YouTube publish date as YYYY-MM-DD hh:mm:ss')
            thumbnail: (type: 'string' ⋄ format: 'uri')
            title: (type: 'string')
            url: (type: 'string' ⋄ format: 'uri')
            youtube_id: (type: 'string')
        )
       )

       error←(
        type: 'object'
        description: 'Every error uses this envelope. Sections are separate so a client can format each as it likes.'
        required: ('error' ⋄ 'message' ⋄ 'request' ⋄ 'query_parameters')
        properties: (
            error:   (type: 'integer' ⋄ description: 'HTTP status code, matching the status line')
            message: (type: 'string' ⋄ description: 'Human-readable description, safe to show a user')
            request: (
                type: 'object'
                description: 'The request that failed'
                required: ('method' ⋄ 'endpoint')
                properties: (
                    method:   (type: 'string' ⋄ example: 'GET')
                    endpoint: (type: 'string' ⋄ example: '/videos')
                )
            )
            query_parameters: (
                type: 'object'
                description: 'Query parameters as received; empty object when there were none'
                additionalProperties: (type: 'string')
            )
            detail: (type: 'string' ⋄ description: 'Technical detail of the fault. Present on 500 only.')
            report_url: (type: 'string' ⋄ format: 'uri' ⋄ description: 'Pre-filled issue report for this fault. Present on 500 only.')
        )
       )

       crud_item←(
        type: 'object'
        properties: (
            id: (type: 'integer')
        )
        additionalProperties: ⊂'true'
        description: 'A table row. Fields beyond "id" depend on the table.'
       )

       pagination_envelope←(
        type: 'object'
        description: 'Pagination metadata wrapper. The "data" field varies by endpoint.'
        properties: (
            path:           (type: 'string' ⋄ description: 'The URL for this endpoint')
            per_page:       (type: 'integer')
            current_page:   (type: 'integer')
            from:           (type: 'integer' ⋄ description: 'Ordinal of the first result on this page')
            to:             (type: 'integer' ⋄ description: 'Ordinal of the last result on this page')
            total:          (type: 'integer' ⋄ description: 'Total count of results for this query, across all pages')
            first_page:     (type: 'integer')
            last_page:      (type: 'integer')
            first_page_url: (type: 'string' ⋄ format: 'uri')
            prev_page_url:  (type: 'string' ⋄ format: 'uri' ⋄ nullable: ⊂'true')
            next_page_url:  (type: 'string' ⋄ format: 'uri' ⋄ nullable: ⊂'true')
            last_page_url:  (type: 'string' ⋄ format: 'uri')
            links:          (type: 'array' ⋄ items: (
                type: 'object'
                description: 'Describes a numbered, previous, or next button for paginated results.'
                properties: (
                    active: (type: 'boolean')
                    label:  (type: 'string')
                    url:    (type: 'string' ⋄ format: 'uri' ⋄ nullable: ⊂'true')
                )
            ))
        )
       )
   :EndNamespace

   :Namespace parameters
   ⍝ Only query parameters required. Path parameters are injected by Stark at route registration (see Run function)

        PerPage←(
            name: 'per_page'
            in: 'query'
            required: ⊂'false'
            schema: (type: 'integer' ⋄ minimum: 1 ⋄ default: 20)
            description: 'Number of results per page.'
        )
        Page←(
            name: 'page'
            in: 'query'
            required: ⊂'false'
            schema: (type: 'integer' ⋄ minimum: 1 ⋄ default: 1)
            description: 'Page number.'
        )

       ⍝ Request headers a client sends to make a conditional request.
        conditional←(
                (name:'If-None-Match' ⋄ in:'header' ⋄ required:⊂'false' ⋄ schema:(type:'string') ⋄ description:'ETag from an earlier response. Returns 304 if it still matches, so the body is not re-sent.')
                (name:'If-Modified-Since' ⋄ in:'header' ⋄ required:⊂'false' ⋄ schema:(type:'string') ⋄ description:'Last-Modified HTTP-date from an earlier response. Returns 304 if the data has not changed since. Ignored when If-None-Match is also supplied.')
        )

   :EndNamespace

   :Namespace headers   ⍝ Response headers. A Header Object is a Parameter Object without "name" and "in".

        cache←(
            ETag: (schema:(type:'string') ⋄ description:'Datetime of last successful cache build YYYYMMDDhhmmssfff by convention. Updates only when cache content changes.')
            ⍙Last⍙45⍙Modified: (schema:(type:'string') ⋄ description:'HTTP-date of the last time the cache data changed.')
            ⍙Cache⍙45⍙Control: (schema:(type:'string') ⋄ description:'Instructions for downstream caches (browsers, proxies, CDNs etc.)')
        )

   :EndNamespace

   :Namespace responses

         not_found←(
            description: 'Resource not found'
            content: (⍙application⍙47⍙json: (schema: ##.schemas.error))
        )

        unauthorized←((
            description: 'Missing or invalid API key.'
            content: (⍙application⍙47⍙json: (schema: ##.schemas.error))
            example: (
                error: 401
                message: 'Missing or invalid X-API-Key header'
            )
        ))

        not_modified←(
            description: 'Cache was not modified since this ETag or Last-Modified datetime'
            headers: ##.headers.cache
        )

        unavailable←(
            description: 'Cache has not been built yet. Retry shortly.'
            content: (⍙application⍙47⍙json: (schema: ##.schemas.error))
            example: (
                error: 503
                message: 'Cache is being built. Retry shortly.'
            )
        )

   :EndNamespace

:EndNamespace
