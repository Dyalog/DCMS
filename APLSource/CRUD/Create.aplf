 r←Create req;GBL;columns;eg;idx;our_cols;parameters;responses;schemas;table;values
⍝ Handles POST /crud/{table}; inserts JSON rows, returns created records

 :If 2=⎕NC'req'
     (schemas responses parameters)←##.SPEC.(schemas responses parameters)
 :EndIf
 :If req≡'⍠SPEC'
     r←(
         tags:,⊂'Table CRUD' ⋄ summary:'Create rows' ⋄ operationId:'createRows'
         body: (
            required: ⊂'true' ⋄ content: (⍙application⍙47⍙json: (
                schema: (type: 'array' ⋄ items: schemas.crud_item)
            ))
         )
         responses: (
            ⍙201: (
                description: 'Created. Returns affected records.'
                content: (⍙application⍙47⍙json:(
                    schema: (type: 'array' ⋄ items: schemas.crud_item)
                ))
            )
            ⍙400:(
                 description:'Invalid payload. Request body must be a JSON array of objects.'
                 content:(⍙application⍙47⍙json:(schema:schemas.error))
            )
            ⍙401: responses.unauthorized
            ⍙404: responses.not_found
         )
     )
     :Return
 :EndIf

 ##.Log'[REQ] POST /crud/',req.PathParams ⎕VGET⊂'table' ''

 'Cache-Control' req.SetHeader 'no-store'

 table←req.PathParams ⎕VGET⊂'table' ''
 GBL←##.GLOBAL
 :If 0∊⍴table
 :OrIf (≢GBL.tables)<idx←GBL.tables⍳⊆table
     ⎕SIGNAL⊂('EN' 404)('Vendor' 'DCMS')('Message'(##.SPEC.responses.not_found.description))
 :EndIf

 :If 1≠≢⍴req.Payload
 :OrIf 0=≢req.Payload
 :OrIf 9≠⎕NC'eg'⊣eg←req.Payload[1]
     ⎕SIGNAL⊂('EN' 400)('Vendor' 'DCMS')('Message' 'Request body must be a non-empty JSON array of objects.')
 :EndIf
 columns←req.Payload[1].⎕NL ¯2
 our_cols←idx⊃GBL.columns
 :If 0∊⍴columns
     ⎕SIGNAL⊂('EN' 400)('Vendor' 'DCMS')('Message' 'Request payload must include columns to insert.')
 :ElseIf ∨/(≢our_cols)<our_cols⍳columns
     ⎕SIGNAL⊂('EN' 400)('Vendor' 'DCMS')('Message' 'One or more specified columns are not valid.')
 :EndIf

 values←↑req.Payload ⎕VGET columns

 :Hold 'SQL.db'
     r←##.QUERY.Table2JSON our_cols⍪##.SQL.Insert(table:table ⋄ columns:columns ⋄ values:values ⋄ returning:our_cols)
 :EndHold
 req.SetStatus 201
