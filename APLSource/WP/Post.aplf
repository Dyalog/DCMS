 r←Post info;h;name;pass;url;wp
⍝ POST info to WordPress at info.endpoint and return the response data.
 :If 0≡info ⋄ r←'' ⋄ →0 ⋄ :EndIf   ⍝ info is a prototype if the list is empty
 wp←##.GLOBAL.secrets.wordpress
 url←wp.url
 name←wp.user
 pass←wp.token~' '
 h←##.##.HttpCommand.New'POST'
 h.URL←RemoveDuplicateSlashes url,info.endpoint
 'Accept-Encoding'h.AddHeader'gzip,deflate'
 h.Auth←name pass
 h.TranslateData←1  ⍝ Automatically convert JSON response to namespace
 h.Params←info
 r←h.Run
 :If 0≠r.rc
     ⎕SIGNAL⊂('EN' 502)('Message' r.msg)('Vendor' 'DCMS')
 :ElseIf 201 207(~∨/⍤∊)r.HttpStatus
     ⎕SIGNAL⊂('EN' 502)('Message' ('WordPress CPTCreate POST FAILED: ',r.(⍕HttpStatus),' ',r.HttpMessage))('Vendor' 'DCMS')
 :EndIf
 r←r.Data
