 new←RefreshData opt;build_opt;result;⍙CACHE;Content
⍝ opt: whether to build cache in isolate or main process :: Boolean
⍝ new: newly built cache namespace                       :: namespace
 :Trap 202 404
     ##.IMPORT.YOUTUBE.RefreshData''
 :Else
     ##.Log'[REFRESH] DATA NOT REFRESHED. ',⎕DMX.Message
 :EndTrap
 build_opt←(
     using:##.⎕USING
     app_dir:##.app_dir
 )
 :If opt
     ⍙CACHE←#.ø #.DCMS.CACHE         ⍝ Spawn isolate to build cache in separate process
     result←⍙CACHE.Build build_opt   ⍝ Build new cache in isolate. Does not block threads in main process despite waiting for future to resolve.
     ##.Log'[REFRESH] ⍙CACHE isolate running:',#.isolate.Running'result'
     'new'⎕NS result                 ⍝ Must deep clone 'new'⎕NS ref because result ref from namespace-returning isolate cannot be dotted into (interpreter bug)
 :Else
     'new'⎕NS #.DCMS.CACHE.Build build_opt
 :EndIf
⍝ Replace sub-namespace references with local copies, so the cache is self-contained and can be written to a component file.
 new.presenters←⎕NS¨new.presenters
 new.events.data←⎕NS¨new.events.data
 new.videos←⎕NS new.videos
 
 Content←{1(220⌶)(⍵.videos.(fields values))(⍵.events.data)(⍵.events.has_videos)(⍵.presenters)}
 :If (Content new)≡Content #.DCMS.GLOBAL.cache
     new.last_updated←#.DCMS.GLOBAL.cache.last_updated
 :Else
     new.last_updated←1 ⎕DT'Z'
 :EndIf

 new.etag←'W/"','"',⍨'0'@(' '∘=)∊4 2 2 2 2 2 3-⍛↑∘⍕¨⊃1 ¯1 ⎕DT new.last_updated

 new←#.DCMS.CACHE.Rehydrate new      ⍝ Hash the index and bind the lookup function over it

 #.DCMS.GLOBAL.cache←new         ⍝ Single-line update is safe across threads. Readers take snapshots to get complete cache view.

⍝ Persist the cache we are now serving, so the next cold start can serve it immediately.
 (##.GetEnv'CACHE_FILE')WriteCache new

 ##.Log'[REFRESH] Refreshed #.DCMS.GLOBAL.cache'
