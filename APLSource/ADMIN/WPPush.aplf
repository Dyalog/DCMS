 r←WPPush req;responses
⍝ Admin endpoint triggering a push of Team Dyalog video listings to WordPress
 :If req≡'⍠SPEC'
     responses←##.SPEC.responses
     r←(
         tags:,⊂'Admin' ⋄ summary:'Trigger a push of WordPress Team Dyalog video listings' ⋄ operationId:'triggerWPPush'
         responses:(
             ⍙200:(
                 description:'Push processed. Returns the result of each WordPress post action.'
                 content:(⍙application⍙47⍙json:(schema:(
                     type:'array'
                     items:(
                         type:'object'
                         properties:(
                             post_id:(type:'integer')
                             action:(type:'string' ⋄ enum:('create' 'delete' 'update'))
                             success:(type:'boolean')
                         )
                     )
                 )))
             )
             ⍙401:responses.unauthorized
             ⍙502:(
                 description:'WordPress rejected the request or was unreachable. Signalled by WP.Post.'
                 content:(⍙application⍙47⍙json:(schema:##.SPEC.schemas.error))
             )
         )
     )
     :Return
 :EndIf
 r←##.WP.PushTeamDyalogVideos req
