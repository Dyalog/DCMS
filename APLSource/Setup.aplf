 Setup
⍝ Load dependencies into the active workspace
 ⎕←'Setting up...'
 :Trap 0
     'GLOBAL'⎕NS''
     GLOBAL.app_dir←app_dir←{'/'=⊃⌽⍵:⍵ ⋄ '/',⍨⍵}GetEnv'APP_DIR'
     ⎕←'App directory is ',app_dir
    ⍝ Data refresh state. running/thread are the refresh serialisation lock; the rest is served by /admin/refresh/status.
     GLOBAL.refresh←(
         running:0 ⋄ thread:¯1 ⋄ pending:0
         started_at:⊂'null' ⋄ finished_at:⊂'null'
         last_success_at:⊂'null' ⋄ last_error_at:⊂'null'
         last_error_message:''
     )
    ⍝ Whether the cache is built in an isolate (production) or the main process (tests)
     GLOBAL.build_in_isolate←⊃(2⊃⎕VFI GetEnv'BUILD_IN_ISOLATE'),1
     ⎕←'Loading dependencies...'
     :If 0=#.⎕NC'Conga'
         'Conga'#.⎕CY'conga'
         #.DRC←#.Conga.Init''
         ⎕←'Conga initialised'
     :EndIf
     #.⎕CY'isolate'
     {}#.isolate.Config'maxws'(GetEnv'MAXWS')   ⍝ Isolates default to 256M
     ⎕←'Isolate loaded into #'
     Unidecode.MakeCharMap app_dir,'/APLSource/charmap.json'
     ⎕←'Loading Tatin packages...'
     ⎕←⍪⎕SE.Tatin.LoadDependencies (GetEnv'PKG') #
     ⎕←'Loading NuGet packages...'
     ⎕←⍪⎕USING←##.NuGet.Using GetEnv'PKG_NUGET'
     ⎕←'Loading Swagger UI static assets...'
     GLOBAL.web_asset_names←'index.html' 'swagger-ui.css' 'theme.css' 'swagger-ui-bundle.js'
     GLOBAL.web_assets←WEB.ReadBytes¨(app_dir,'assets/swagger-ui/')∘,¨GLOBAL.web_asset_names
 :Else
     ⎕←'Could not set up DCMS'
     ⎕←1⎕JSON⎕OPT'Compact'0⊢⎕DMX
     ⎕OFF 1
 :EndTrap