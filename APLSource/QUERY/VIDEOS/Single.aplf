 res←Single req;CACHE;headers;id;idx;parameters;responses;schemas;ytid
⍝ Serve GET /videos/{youtube_id}, returning one video or 404

 :If '⍠SPEC'≡req
     (schemas responses parameters headers)←##.##.SPEC.(schemas responses parameters headers)
     res←(tags:,⊂'Videos' ⋄ summary:'Get a single video' ⋄ operationId: 'getVideo' ⋄ security:⍬
         parameters: parameters.conditional
         responses:(
             ⍙200:(
                 description:'A single video object'
                 headers: headers.cache
                 content:(⍙application⍙47⍙json:(schema: schemas.video))
             )
             ⍙304: responses.not_modified
             ⍙404: (
                 description:'Video not found'
                 content:(⍙application⍙47⍙json:(schema: schemas.error))
             )
             ⍙503:responses.unavailable
         )
     )
     :Return
 :EndIf

 ##.##.Log'[REQ] GET /videos/',req.PathParams.youtube_id

 :If 0=#.DCMS.GLOBAL.⎕NC'cache'   ⍝ 503 unavailable instead of 500 VALUE ERROR
     ⎕SIGNAL⊂('EN' 503)('Vendor' 'DCMS')('Message' 'Cache is being built. Retry shortly.')
 :EndIf
 CACHE←#.DCMS.GLOBAL.cache

 id←req.PathParams.youtube_id

 ytid←CACHE.videos.index_cols⊃⍨CACHE.videos.fields⍳⊂'youtube_id'
 idx←ytid⍳id

 :If idx>≢ytid
     ⎕SIGNAL⊂('EN' 404)('Vendor' 'DCMS')('Message' 'Video not found.')
 :Else
     res←⊃##.Table2JSON CACHE.videos.fields⍪(CACHE.videos.values⍪⊂'')[,ytid⍳id;]
 :EndIf

 req←##.CacheControl req
 :If 304=req.Response.Status
     res←''
     :Return
 :EndIf
