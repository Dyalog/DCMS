 res←Query req;C;CACHE;Norm;Q;Stem;ddn;event;filter;fm;headers;in_range;index_width;parameters;pg;ppg;presenter;presenter_id;q_event;responses;rows;schemas;stemmer;terms;to
⍝ Serve GET /videos: search, filter, rank, sort and paginate

 :If req≡'⍠SPEC'
     (schemas responses parameters headers)←##.##.SPEC.(schemas responses parameters headers)
     res←(
         tags:,⊂'Videos' ⋄ summary:'Search and list videos' ⋄ operationId:'getVideos' ⋄ security:⍬
         description:'Returns a paginated envelope of video results. All responses use the envelope format with data, pagination metadata, and navigation links.'
         parameters:(
             (name:'from' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'string' ⋄ format:'date-time'))
             (name:'to' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'string' ⋄ format:'date-time'))
             (name:'presenter_id' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'array' ⋄ items:(type:'integer')) ⋄ explode:⊂'false' ⋄ description:'Comma-separated list of presenter IDs from GET /presenters, e.g. "123,456". A video matches only if it has every listed presenter.')
             (name:'event' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'string' ⋄ default:'') ⋄ description:'URL slug of event, e.g. "dyalog-23", used to filter results. Defaults to "all events / any event".')
             (name:'search' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'string') ⋄ description:'Full-text search across video titles, descriptions, presenter names, and event names')
             (name:'sort' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'string' ⋄ enum:('relevance' 'newest' 'oldest')) ⋄ description:'Sort order of results. Defaults to "relevance" when `search` is supplied, otherwise "newest".')
             (name:'page' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'integer' ⋄ minimum:1 ⋄ default:1) ⋄ description:'Page number for paginated results.')
             (name:'per_page' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'integer' ⋄ minimum:1 ⋄ default:20) ⋄ description:'Number of results per page for paginated results. Defaults to 20.')
         ),parameters.conditional
         responses:(
             ⍙200:(
                 description:'Paginated video results'
                 headers: headers.cache
                 content:(⍙application⍙47⍙json:(schema:(type:'object' ⋄ properties:(
                                 path:(type:'string' ⋄ description:'URL for this endpoint')
                                 per_page:(type:'integer')
                                 current_page:(type:'integer')
                                 data:(type:'array' ⋄ items:schemas.video)
                                 from:(type:'integer' ⋄ description:'Ordinal of the first result on this page')
                                 to:(type:'integer' ⋄ description:'Ordinal of the last result on this page')
                                 total:(type:'integer' ⋄ description:'Total count of results for this query, across all pages')
                                 first_page:(type:'integer' ⋄ description:'Page number of the first page of results (always 1)')
                                 last_page:(type:'integer' ⋄ description:'Page number of the last page of results')
                                 first_page_url:(type:'string' ⋄ format:'uri')
                                 prev_page_url:(type:'string' ⋄ format:'uri' ⋄ nullable:⊂'true')
                                 next_page_url:(type:'string' ⋄ format:'uri' ⋄ nullable:⊂'true')
                                 last_page_url:(type:'string' ⋄ format:'uri')
                                 links:(type:'array' ⋄ items:(
                                         type:'object'
                                         description:'Describes numbered, previous and next buttons for paginated results.'
                                         properties:(
                                             active:(type:'boolean')
                                             label:(type:'string')
                                             url:(type:'string' ⋄ format:'uri' ⋄ nullable:⊂'true')
                                         )
                                     ))
                             ))))
             )
             ⍙304: responses.not_modified
             ⍙400:(
                 description:'Invalid query parameters'
                 content:(⍙application⍙47⍙json:(schema:schemas.error))
             )
             ⍙500:(
                 description:'Internal server error'
                 content:(⍙application⍙47⍙json:(schema:schemas.error))
             )
             ⍙503:responses.unavailable
         )

     )
     :Return
 :EndIf

 ##.##.Log'[REQ] GET /videos ',1 ⎕JSON req.QueryParams
 
 Q←req.QueryParams∘⎕VGET

⍝ Validate query parameters that can 400 before the cache control check. A 304 stands in for a 200 so malformed requests must fail first.
 :Trap 11
     (fm to)←##.TimeStamp2DDN Q('from' '')('to' '')
 :Else
     ⎕SIGNAL⊂('EN' 400)('Message' 'Invalid date-time')('Vendor' 'DCMS')
 :EndTrap
 (pg ppg)←2⊃∘⎕VFI¨Q('page' '1')('per_page' '20')
 (pg ppg)←⊃¨(pg,1)(ppg,20)   ⍝ ?page= / ?per_page= with no value take the defaults
 :If 0≥pg
     ⎕SIGNAL⊂('EN' 400)('Message' 'If supplied, page number must be a positive integer.')('Vendor' 'DCMS')
 :EndIf

 req←##.CacheControl req
 :If 304=req.Response.Status
     res←''
     :Return
 :EndIf

 CACHE←#.DCMS.GLOBAL.cache
 C←CACHE.videos.(index_cols⊃⍨fields⍳⊂)

⍝ Filter by date range
 in_range←(fm to)FilterDateTimes ddn←C'presented_at'

⍝ Filter by columns: presenter_id, event
 presenter_id←∧⌿∨/(2⊃','⎕VFI Q⊂'presenter_id' '')∘.=(C'presenter_id')
 event←(q_event∘≡¨C'event_shortname')∨0∊⍴q_event←Q⊂'event' ''
 filter←in_range∧event∧presenter_id

 Norm←##.##.Unidecode.NormaliseText
 stemmer←⎕NEW #.DCMS.Porter2Stemmer.EnglishPorter2Stemmer
 Stem←{
     stemmed←stemmer.Stem⊆⍵
     stemmed.Value
 }
⍝ Rank by search terms
 index_width←CACHE.videos.index_width
 terms←(≢terms)(index_width)↑↑terms←∪terms⊆⍛,Stem¨terms←', '(~⍤∊⍨⊆⊢)Norm Q⊂'search' ''
 rows←⍸filter   ⍝ Rows matching the filters
 :If 0<≢terms
     rows←(CACHE.videos.Lookup terms)Rank CACHE.videos.search rows
 :EndIf

⍝ Sort
 :Select Q⊂'sort' ''   ⍝ FIXME should be newest unless search is not empty
 :Case 'newest'
     rows←rows[⍒ddn[rows]]   ⍝ newest
 :Case 'oldest'
     rows←rows[⍋ddn[rows]]   ⍝ oldest
 :EndSelect

⍝ Paginate row ordinals, then convert only this page to JSON
 res←('videos'pg ppg)##.Paginate ⍳≢rows
 res.data←##.Table2JSON CACHE.videos.fields⍪CACHE.videos.values[rows[res.data];]
