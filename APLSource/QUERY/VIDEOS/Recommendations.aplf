 res←Recommendations req;Values;all_id;fid;fields;headers;n;parameters;rec;responses;schemas;this;vids;ytid
⍝ List of video objects most related to video with youtube_id given by "youtube_id" path parameter

 :If '⍠SPEC'≡req
     (schemas responses parameters headers)←##.##.SPEC.(schemas responses parameters headers)
     res←(tags:,⊂'Videos' ⋄ summary:'Get video recommendations' ⋄ operationId:'getVideoRecommendations' ⋄ security:⍬
         parameters:(
             (name:'youtube_id' ⋄ in:'path' ⋄ required:⊂'true' ⋄ schema:(type:'string') ⋄ description:'11-character YouTube video ID')
             (name:'n' ⋄ in:'query' ⋄ required:⊂'false' ⋄ schema:(type:'integer' ⋄ minimum:1 ⋄ default:5) ⋄ description:'Number of recommendations to return')
         ),parameters.conditional
         responses:(
             ⍙200:(
                 description:'List of recommended videos'
                 headers: headers.cache
                 content:(⍙application⍙47⍙json:(schema:(type:'array' ⋄ items:schemas.video)))
             )
             ⍙304: responses.not_modified
             ⍙400:(
                 description:'Bad request, e.g. invalid YouTube ID format'
                 content:(⍙application⍙47⍙json:(schema:schemas.error))
             )
             ⍙404:(
                 description:'Video not found'
                 content:(⍙application⍙47⍙json:(schema:schemas.error))
             )
             ⍙503:responses.unavailable
         )
     )
     :Return
 :EndIf

 ##.##.Log'[REQ] GET /videos/',req.PathParams.youtube_id,'/recommendations'
 
 ytid←req.PathParams.youtube_id
 :If 11≠≢ytid
     ⎕SIGNAL⊂('EN' 400)('Vendor' 'DCMS')('Message' 'YouTube ID must be an 11-character string.')
 :EndIf
 n←2⊃⎕VFI req.QueryParams ⎕VGET⊂(,'n')'5'   ⍝ Number of results. Default 5.
 n←⊃n,5                                     ⍝ ?n= with no value takes the default
 :If (1>n)∨n≠⌊n
     ⎕SIGNAL⊂('EN' 400)('Vendor' 'DCMS')('Message' 'If supplied, n must be a positive integer.')
 :EndIf

 :If 0=#.DCMS.GLOBAL.⎕NC'cache'   ⍝ 503 unavailable instead of 500 VALUE ERROR
     ⎕SIGNAL⊂('EN' 503)('Vendor' 'DCMS')('Message' 'Cache is being built. Retry shortly.')
 :EndIf
 vids←#.DCMS.GLOBAL.cache.videos
 all_id←vids.index_cols⊃⍨vids.fields⍳⊂'youtube_id'
 :If (≢ytid)=⊢/⍴all_id
     this←all_id⍳ytid
 :AndIf this≤≢vids.values
     n←n⌊⊢/⍴vids.recommendations   ⍝ Corpus may hold fewer than n
     rec←vids.recommendations[this;⍳n]
     res←##.Table2JSON vids.fields⍪vids.values[rec;]
 :Else
     ⎕SIGNAL⊂('EN' 404)('Vendor' 'DCMS')('Message' 'Video not found.')
 :EndIf

 req←##.CacheControl req
 :If 304=req.Response.Status
     res←''
     :Return
 :EndIf
