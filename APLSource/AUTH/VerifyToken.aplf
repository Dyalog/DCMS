 VerifyToken←{
⍝ ⍵: Jarvis HTTP request object
⍝ ←: Jarvis authentication result (0 for success, non-zero to fail request)
     h←⍵.Headers
     i←(⊣/h)⍳⊂'x-api-key'
     i>≢h:Reject ⍵      ⍝ FAIL 'No x-api-key header found'
     try←h⊃⍨⊂2,⍨i
     key←##.GLOBAL.secrets.upload_token
     try≢key:Reject ⍵   ⍝ FAIL 'Invalid x-api-key'
     0
 }
