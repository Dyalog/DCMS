 r←Test_PUTProfiling_Idempotent url;Assert;key;res;since1;since2
⍝ Check repeating PUT /admin/profiling?on=true leaves since unchanged
 r←0
 Assert←##.Assert
 :Trap 0
     res←('PUT'Authed url,'/admin/profiling?on=true').Run
     Assert 204=res.HttpStatus
     res←('GET'Authed url,'/admin/profiling').Run
     Assert 200=res.HttpStatus
     since1←res.Data.since
     res←('PUT'Authed url,'/admin/profiling?on=true').Run
     Assert 204=res.HttpStatus
     res←('GET'Authed url,'/admin/profiling').Run
     Assert 200=res.HttpStatus
     since2←res.Data.since
     Assert since1≡since2
     r←1
 :EndTrap
⍝ Teardown: ensure profiling is off and data cleared regardless of outcome
 {}('PUT'Authed url,'/admin/profiling?on=false').Run
 {}('DELETE'Authed url,'/admin/profile').Run
