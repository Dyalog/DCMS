 r←Test_Profile_Body url;Assert;fields;first;key;res
⍝ Check GET /admin/profile returns rows with the expected fields
 r←0
 key←#.DCMS.GLOBAL.secrets.upload_token
 Assert←##.Assert
 :Trap 0
     res←('PUT'Authed url,'/admin/profiling?on=true').Run
     Assert 204=res.HttpStatus
     ⍝ Generate some profile data via an authed GET
     res←('GET'Authed url,'/admin/profiling').Run
     Assert 200=res.HttpStatus
     res←('GET'Authed url,'/admin/profile').Run
     Assert 200=res.HttpStatus
     Assert 0<≢res.Data
     first←⊃res.Data
     fields←'fn_name' 'line_no' 'n_calls' 'exclusive_time' 'inclusive_time'
     Assert ∧/0≠first.⎕NC fields
     r←1
 :EndTrap
⍝ Teardown: ensure profiling is off and data cleared regardless of outcome
 {}('PUT'Authed url,'/admin/profiling?on=false').Run
 {}('DELETE'Authed url,'/admin/profile').Run
